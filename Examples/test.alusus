import "Srl/Console";
import "Srl/Regex";
import "Srl/Fs";
import "Apm";
Apm.importPackage("Alusus/MarkdownTranslator@0.1");
Apm.importPackage("Alusus/ProgArg@0.2");

use Srl;

def md: String = Fs.readFile("test.md");
def translator: MarkdownTranslator[Regex.Matcher];

ProgArg.initialize();
ProgArg.cmdDef = ProgArg.CmdDef().{
    description = "Run the test and print the result.";
    callback = closure (options: Map[String, String], args: Array[String]) {
        def expectedHtml: String = Fs.readFile("test.html");
        def generatedHtml: String = translator.translate(md);
        if generatedHtml == expectedHtml {
            Console.print("Test successful.\n");
        } else {
            Console.print("Test failed.\n");
        }
    };
    subCmds = Array[SrdRef[ProgArg.CmdDef]]({
        ProgArg.CmdDef().{
            kwd = "print";
            description = "Print the generated html.";
            callback = closure (options: Map[String, String], args: Array[String]) {
                def generatedHtml: String = translator.translate(md);
                Console.print(generatedHtml);
            };
        },
        ProgArg.CmdDef().{
            kwd = "update";
            description = "Update the test snapshot.";
            callback = closure (options: Map[String, String], args: Array[String]) {
                def generatedHtml: String = translator.translate(md);
                Fs.createFile("test.html", generatedHtml, generatedHtml.getLength());
            };
        }
    });
};
ProgArg.parse(2);
